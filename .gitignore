# Записи матчей: большие файлы, GitHub не примет >100 МБ на файл.
*.mp4
*.mov
*.mkv
*.webm
*.wav

# Скриншоты матча — рабочий материал для разметки, в репозиторий не идут.
photo_*.jpg
photo_*.jpeg
photo_*.png
screenshot_*.png

# Личные экспорты разметки и состояние браузера.
data/*.json
!data/example-events.json
tenshiro-replay-analysis.json
*.local.json

# Пустые черновики отчётов (Word/Excel сохранили файлы без содержимого).
Отчёты/

# Системный и редакторский мусор, лок-файлы Office.
.DS_Store
Thumbs.db
desktop.ini
~$*
.vscode/
