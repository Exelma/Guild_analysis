# В репозитории всегда LF, независимо от core.autocrlf на машине.
* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Бинарные файлы: без диффов, без преобразования переводов строк.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.mp4  binary
